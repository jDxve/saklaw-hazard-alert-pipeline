rules_version = '2';

// The app never talks to Firestore. It reads hazards over HTTPS from the
// `hazardsApi` function, which uses the Admin SDK and so bypasses these rules
// entirely; the ingestion functions write the same way.
//
// That leaves no legitimate client path into this database, so there is none.
// Denying by default is what makes the read API the only door: without it,
// whether a phone could read `hazard_events` would depend on a console setting
// nobody wrote down.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
