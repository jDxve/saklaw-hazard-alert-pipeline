{
  "name": "saklaw-hazard-alert-pipeline",
  "version": "1.1.0",
  "description": "Fetches PHIVOLCS/PAGASA/NOAH hazard feeds, classifies severity, dedupes into Firestore, and pushes FCM alerts for the Saklaw app.",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "tsx scripts/run-tests.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "cheerio": "^1.0.0",
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.3.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cheerio": "^0.22.35",
    "@types/node": "^22.20.1",
    "eslint": "^9.9.0",
    "jiti": "^2.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.3.0"
  }
}
