    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/node": "^20.0.0",
    "@eslint/js": "^9.9.0",
    "eslint": "^9.9.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.3.0",
    "tsx": "^4.19.0"
  }
